# 复制为 .env 后填入真实的 OpenCode Go API Key（不要把 .env 提交到 Git）
OPENCODE_API_KEY=oc_sk_xxxxxxxxxxxxxxxx

# 可选配置
# OPENCODE_API_BASE=https://opencode.ai/inference/go/openai/v1
# OPENCODE_MODEL=deepseek-v4.1-flash
# OPENCODE_MAX_TOKENS=1200
# OPENCODE_SESSION_ID=combo-lab

# 图片生成（两个来源，auto 时配了 key 优先用 key，否则用免费的 Pollinations）
# IMAGE_PROVIDER=auto          # auto | pollinations | openai
# IMAGE_API_BASE=https://api.siliconflow.cn/v1
# IMAGE_API_KEY=
# IMAGE_MODEL=Kwai-Kolors/Kolors
# IMAGE_SIZE=1024x1024
# IMAGE_CACHE_DIR=.cache/images
# 提示：Pollinations 免费额度约每 IP 45 秒 1 张，现场连续演示建议配置 IMAGE_API_KEY
